{
  "name": "karma",
  "version": "0.1.0",
  "description": "Karma - see your karma, grow every day",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "supabase:migrate": "npx supabase db push",
    "supabase:functions:deploy": "npm run sync:shared && npx supabase functions deploy analyze-day --use-api && npx supabase functions deploy delete-account --use-api && npx supabase functions deploy transcribe --use-api && npx supabase functions deploy admin-users --use-api",
    "seed": "tsx scripts/seed.ts",
    "eval:ai": "node --experimental-strip-types --no-warnings scripts/eval-ai.mjs",
    "sync:shared": "node scripts/sync-shared.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "astronomy-engine": "^2.1.19",
    "framer-motion": "^14.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module"
}
