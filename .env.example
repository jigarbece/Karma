# ---------------------------------------------------------------------------
# Browser (Vite) variables. Safe to expose: they ship inside the JS bundle.
# Copy to .env.local for development; set the same names in Vercel for production.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY
# Optional
VITE_GHADA_DAILY_CAP=50
VITE_DAILY_ANALYSIS_LIMIT=10
# Set true to also show "Try the demo" when Supabase IS configured
VITE_ALLOW_DEMO=false

# ---------------------------------------------------------------------------
# Edge Function SECRETS. NEVER prefix these with VITE_ and never commit real values.
# Set them with:  supabase secrets set --env-file supabase/.env.secrets   (file is git-ignored)
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
# ---------------------------------------------------------------------------
AI_PROVIDER=gemini            # gemini | groq | anthropic | openai
AI_MODEL=                     # optional; defaults: gemini-3.8-flash, llama-3.3-70b-versatile, claude-haiku-5-5, gpt-4o-mini
AI_API_KEY=
# Optional fallback used only if the primary provider fails (recommended in production)
AI_FALLBACK_PROVIDER=         # e.g. groq
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
DAILY_ANALYSIS_LIMIT=10
# One origin or a comma-separated list, e.g. https://karma.example.com,http://localhost:5173
ALLOWED_ORIGIN=https://YOUR-DOMAIN   # CORS origin for the functions

# ---------------------------------------------------------------------------
# Google sign-in (used by supabase/config.toml for local dev; in hosted Supabase set it in the dashboard)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Seed script only (local/dev). Never use against production.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
